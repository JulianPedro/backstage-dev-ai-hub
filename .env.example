# Integration credentials for the local dev harness.
# Copy to `.env` and fill in — never commit the filled file, and never inline
# these values in `app-config*.yaml`.
#
# A GitHub App is required for the URL reader to fetch resource bodies from
# private repositories; public sources work without it.

GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Paste the PEM contents; wrap in quotes if it spans multiple lines.
GITHUB_PRIVATE_KEY=

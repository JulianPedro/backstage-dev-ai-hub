{
  "name": "@nospt/plugin-dev-ai-hub-backend",
  "version": "1.0.0-rc1",
  "description": "Backend plugin for Dev AI Hub",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/nosportugal/backstage-plugin-dev-ai-hub"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "files": [
    "dist",
    "migrations",
    "config.d.ts",
    "README.md"
  ],
  "configSchema": "config.d.ts",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "dev-ai-hub",
    "pluginPackages": [
      "@nospt/plugin-dev-ai-hub",
      "@nospt/plugin-dev-ai-hub-backend",
      "@nospt/plugin-dev-ai-hub-common"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start --config ../../app-config.dev.yaml",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack",
    "test": "backstage-cli package test --passWithNoTests --watchAll=false",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.1",
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/plugin-catalog-node": "^2.2.2",
    "@nospt/plugin-dev-ai-hub-common": "workspace:^",
    "archiver": "^6.0.0",
    "express": "^5.2.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.17.1",
    "@backstage/backend-test-utils": "^1.11.3",
    "@backstage/cli": "^0.36.2",
    "@backstage/plugin-auth-backend": "0.29.0",
    "@backstage/plugin-auth-backend-module-guest-provider": "0.2.10",
    "@backstage/plugin-catalog-backend": "^3.8.0",
    "@backstage/plugin-catalog-backend-module-ai-model": "^0.1.1",
    "@types/archiver": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/supertest": "^6.0.0",
    "better-sqlite3": "^12.0.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.0.0",
    "knex": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "plugin\\.ts$"
    ]
  }
}

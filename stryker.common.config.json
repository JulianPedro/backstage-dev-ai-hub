{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "yarn workspace @nospt/plugin-dev-ai-hub-common run test"
  },
  "coverageAnalysis": "off",
  "timeoutMS": 30000,
  "timeoutFactor": 3,
  "concurrency": 2,
  "checkers": ["typescript"],
  "tsconfigFile": "plugins/dev-ai-hub-common/tsconfig.json",
  "mutate": [
    "plugins/dev-ai-hub-common/src/resources.ts",
    "plugins/dev-ai-hub-common/src/toResourceSummary.ts",
    "plugins/dev-ai-hub-common/src/telemetry.ts",
    "!plugins/dev-ai-hub-common/src/**/*.test.ts"
  ],
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/common/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/common/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}

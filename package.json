{
  "name": "backstage-plugin-dev-ai-hub",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "24"
  },
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "start": "yarn start:frontend & yarn start:backend",
    "start:frontend": "yarn workspace @nospt/plugin-dev-ai-hub start",
    "start:backend": "yarn workspace @nospt/plugin-dev-ai-hub-backend start",
    "build:all": "yarn workspaces foreach --all --topological-dev run build",
    "test": "yarn workspaces foreach --all -p run test --passWithNoTests",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "yarn test:mutation:backend && yarn test:mutation:common",
    "test:mutation:backend": "stryker run stryker.backend.config.json",
    "test:mutation:common": "stryker run stryker.common.config.json",
    "lint:all": "yarn workspaces foreach --all -p run lint",
    "prettier:check": "prettier --check .",
    "lint:md": "markdownlint .",
    "tsc": "tsc",
    "prepare": "pre-commit install || true"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/cli-defaults": "^0.1.5",
    "@playwright/test": "^1.48.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "jest": "^29.0.0",
    "jest-junit": "^17.0.0",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^2.3.2",
    "typescript": "^5.3.0"
  },
  "prettier": "@backstage/cli/config/prettier",
  "jest": {
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 90,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "resolutions": {
    "axios": ">=1.15.2",
    "fast-uri": ">=4.1.2",
    "fast-xml-builder": ">=1.1.7",
    "fast-xml-parser": ">=5.5.6",
    "flatted": ">=3.4.2",
    "handlebars": ">=4.7.9",
    "koa": ">=3.1.2",
    "lodash": ">=4.18.0",
    "node-forge": ">=1.4.0",
    "express/path-to-regexp": "0.1.13",
    "protobufjs": ">=7.5.5",
    "undici": ">=6.24.0",
    "vm2": ">=3.11.6",
    "@backstage/backend-defaults": ">=0.12.2"
  },
  "packageManager": "yarn@4.13.0"
}
